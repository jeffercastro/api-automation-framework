{
  "name": "api-automation-framework",
  "version": "1.0.0",
  "description": "Production-grade API test automation framework with TypeScript, Playwright API, JSON Schema validation, and GitHub Actions CI/CD",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:generated": "playwright test tests/generated",
    "test:report": "playwright show-report",
    "generate:api": "node --experimental-strip-types src/generator/generate-tests.ts",
    "generate:negative": "node --experimental-strip-types src/generator/generate-tests.ts --negative"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "sdet",
    "typescript",
    "json-schema",
    "ci-cd"
  ],
  "author": "Jeffer Castro",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
